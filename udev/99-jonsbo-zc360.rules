# Jonsbo TF3 / ZC-360 fan panels - active desktop user access, not world-write.
SUBSYSTEM=="usb", ATTRS{idVendor}=="43a8", ATTRS{idProduct}=="0e61", MODE="0660", TAG+="uaccess"

# Optional: pump display (640x480, driven separately via
# turing-smart-screen-cli, not by this repo) - uncomment if you use it.
#SUBSYSTEM=="usb", ATTRS{idVendor}=="1cbe", ATTRS{idProduct}=="0035", MODE="0666"
